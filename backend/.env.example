# 이 파일을 복사해 backend/.env 로 저장하고 값을 채우세요.
# 값이 비어 있으면 앱은 자동으로 mock(예시) 데이터로 동작합니다.

# ── 메리츠증권 Open API (해외주식 계좌) ──────────────────────────────
# 메리츠 개발자 포털에서 발급받은 앱키/시크릿. 둘 다 채우면 실계좌로 동작.
# 운영 서버만 존재(모의계좌 없음). 계좌번호는 앱키에 바인딩되어 불필요.
# 조회 전용으로만 사용합니다(주문/환전 없음).
MERITZ_APP_KEY=
MERITZ_APP_SECRET=
# (선택) 서버 주소 변경이 필요할 때만. 기본=운영 서버
# MERITZ_BASE_URL=https://openapi.imeritz.com:9443

# ── (구) 한국투자증권 KIS Developers 자격증명 ─────────────────────────

# KIS Developers 포털(https://apiportal.koreainvestment.com)에서 발급받은 앱키/앱시크릿
KIS_APP_KEY=
KIS_APP_SECRET=

# 계좌번호 (예: 12345678-01). 앞 8자리=종합계좌, 뒤 2자리=상품코드
KIS_ACCOUNT_NO=

# real = 실전투자 / paper = 모의투자
KIS_ENV=real

# ── KIS 실시간 WebSocket (해외선물/환율) ─────────────────────────────
# 1 로 켜면 실제 KIS WebSocket 접속(위 앱키 필요 + '해외선물옵션' API 사용신청/권한 필요).
# 비워두거나 0 이면 시뮬레이터로 동작(키 없이도 실시간 화면 확인 가능).
KIS_ENABLE_WS=

# 실시간체결 tr_id (해외선물 기본값). FX 등 다른 상품이면 상품별로 지정.
KIS_WS_FUT_TRID=HDFFF020
# 체결 프레임(^ 구분)에서 '현재가' 필드 위치. KIS 문서/실수신 로그로 확인해 조정.
KIS_WS_PRICE_INDEX=11
# 각 지표의 KIS 종목코드(tr_key). 발급 후 해외선물 종목코드로 채우세요.
KIS_WS_WTI_KEY=
KIS_WS_BRENT_KEY=
KIS_WS_USDKRW_KEY=
# (선택) 지표별 tr_id 를 다르게 쓰려면: KIS_WS_WTI_TRID, KIS_WS_USDKRW_TRID ...
